# Public site URL used for canonical URLs, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://matenergy.com.pk

# Resend (https://resend.com) – used by /api/lead for all website forms
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Must be on a domain verified in Resend
RESEND_FROM_EMAIL="Mat Energy <noreply@matenergy.com.pk>"
# Comma-separated list of addresses that receive lead notifications
ADMIN_EMAILS=sales@matenergy.com.pk,owner@example.com

# Optional: Google Search Console verification token
GOOGLE_SITE_VERIFICATION=

# Google Analytics tag and Google Tag Manager container (production builds only).
# Defaults to the IDs used on the current site; set to an empty value to disable.
NEXT_PUBLIC_GA_ID=GT-NB3V57Q2
NEXT_PUBLIC_GTM_ID=GTM-5XTD7HD6

# IndexNow (Bing, Yandex, etc.). Any 8–128 character [a-zA-Z0-9-] string; served at /indexnow-key.txt.
# Generate one with: openssl rand -hex 16
INDEXNOW_KEY=
# Vercel sends this as a Bearer token when it runs the weekly IndexNow cron (vercel.json)
CRON_SECRET=
